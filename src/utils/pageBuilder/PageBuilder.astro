---
import TabDivider from "@/components/TabDivider/index.astro";
import { componentsMapper } from "./componentsMapper";
import { getSectionLayout } from "./helpers";
import type { Props } from "./PageBuilder.type";

const { elements = [], facebook = "", instagram = "", phone = "" } = Astro.props as Props;

const layout = getSectionLayout(elements);
---

{
    elements.map((element, index) => {
        const blockType = element._type;
        const Component = blockType
            ? componentsMapper[blockType as keyof typeof componentsMapper]
            : undefined;

        if (!Component) {
            console.warn(`[PageBuilder] Unknown block type "${String(blockType)}" at index ${index}.`);
            return null;
        }

        const { surface, previousSurface, tabLabel } = layout[index];

        return (
            <>
                {tabLabel && previousSurface && (
                    <TabDivider
                        label={tabLabel}
                        from={previousSurface}
                        to={surface}
                    />
                )}
                <div
                    class={surface === "bg-alt" ? "bg-bg-alt" : "bg-bg"}
                    data-surface={surface}
                >
                    <Component
                        {...element}
                        surface={surface}
                        facebook={facebook}
                        instagram={instagram}
                        phone={phone}
                    />
                </div>
            </>
        );
    })
}
