---
import { useTranslations } from "@/i18n/ui";
import Button from "@/components/Button/index.astro";
import Container from "@/components/Container/index.astro";
import Eyebrow from "@/components/Eyebrow/index.astro";
import { sanityImage, sanityImageUrl } from "@/utils/sanityImage";
import type { Props } from "./index.type";

const {
    eyebrow = "",
    heading = "",
    certificates = [],
    button,
    surface = "bg",
} = Astro.props as Props;

const pad = (n: number) => String(n).padStart(2, "0");
const cards = certificates
    .map((item) => {
        const certificate = item.certificate ?? item;
        const url = certificate.image?.asset?.url;
        if (!url) return null;
        const extension =
            url.split("?")[0].split(".").pop()?.toLowerCase() ?? "img";
        const title = certificate.title ?? certificate.image?.alt ?? "";
        return {
            title,
            alt: certificate.image?.alt || title || "Certificate preview",
            image: sanityImage(url, {
                sizes: "min(82vw, 380px)",
                sourceWidth: certificate.image?.asset?.metadata?.dimensions?.width,
                widths: [320, 480, 640, 800],
            }),
            full: sanityImageUrl(url, 2000),
            extension: `.${extension}`,
        };
    })
    .filter((card) => card !== null);

const arrowClass =
    "flex size-12 cursor-pointer items-center justify-center border border-line-strong bg-bg font-mono text-base text-fg transition-colors duration-200 hover:border-acc hover:text-acc";

const { t } = useTranslations(Astro.url);
---

<Container
    className="flex flex-col gap-10 overflow-x-clip py-[clamp(56px,8vw,112px)]"
>
    <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="flex flex-col gap-3.5">
            {eyebrow && <Eyebrow text={eyebrow} />}
            {
                heading && (
                    <h2 class="m-0 text-[clamp(40px,6vw,72px)] leading-none">
                        {heading}
                    </h2>
                )
            }
        </div>
        <div class="flex items-center gap-2.5" data-carousel-controls>
            {
                cards.length > 1 && (
                    <>
                        <button
                            type="button"
                            class={arrowClass}
                            aria-label={t("certificates.previous")}
                            data-carousel-prev
                        >
                            ←
                        </button>
                        <button
                            type="button"
                            class={arrowClass}
                            aria-label={t("certificates.next")}
                            data-carousel-next
                        >
                            →
                        </button>
                    </>
                )
            }
            {
                button?.buttonText && (
                    <Button
                        variant="outline"
                        surface={surface}
                        href={button.buttonLink}
                        label={button.buttonText}
                        srContext={heading}
                        isExternal={button.isExternalLink}
                    />
                )
            }
        </div>
    </div>

    {
        cards.length > 0 && (
            <swiper-container
                class="certificates-swiper relative left-1/2 block w-screen -translate-x-1/2 px-[max(clamp(20px,4vw,48px),calc((100vw-1400px)/2+clamp(20px,4vw,48px)))]"
                init="false"
            >
                {cards.map((card, index) => (
                    <swiper-slide class="w-[min(82%,380px)]!">
                        <button
                            type="button"
                            class="relative block aspect-[16/10] w-full cursor-zoom-in overflow-hidden border border-line bg-surface p-0 transition-colors duration-200 hover:border-acc focus-visible:border-acc"
                            data-lightbox-src={card.full}
                            data-lightbox-title={card.title}
                        >
                            <img
                                src={card.image.src}
                                srcset={card.image.srcset}
                                sizes={card.image.sizes}
                                alt={card.title ? "" : card.alt}
                                class="absolute inset-0 block size-full object-cover object-top"
                                loading="lazy"
                            />
                            <span class="sr-only">{t("certificates.open")}: </span>
                            <span class="absolute inset-x-0 bottom-0 flex justify-between gap-3 bg-bg/90 px-3.5 py-2.5 text-left font-mono text-xs text-fg">
                                <span>
                                    <span class="text-acc">{pad(index + 1)}</span>{" "}
                                    {card.title}
                                </span>
                                <span class="text-dim">{card.extension}</span>
                            </span>
                        </button>
                    </swiper-slide>
                ))}
            </swiper-container>
        )
    }
</Container>

<script>
    // Swiper is fetched only when a gallery gets near the viewport, so it
    // stays off the critical path.
    let observer: IntersectionObserver | undefined;

    const initSwiper = async (swiperEl: HTMLElement) => {
        if (swiperEl.dataset.initialized) return;
        swiperEl.dataset.initialized = "true";

        const { initCertificatesSwiper } = await import(
            "@/scripts/certificatesSwiper"
        );
        initCertificatesSwiper(swiperEl);
    };

    const observeCertificatesSwipers = () => {
        observer?.disconnect();
        observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    observer?.unobserve(entry.target);
                    initSwiper(entry.target as HTMLElement);
                });
            },
            { rootMargin: "600px 0px" },
        );
        document
            .querySelectorAll<HTMLElement>("swiper-container.certificates-swiper")
            .forEach((swiperEl) => observer?.observe(swiperEl));
    };

    document.addEventListener("astro:page-load", observeCertificatesSwipers);
    document.addEventListener("astro:before-swap", () => observer?.disconnect());
    observeCertificatesSwipers();
</script>

<style>
    /* Until Swiper loads, lay the slides out the way it will, so nothing
       shifts when it initializes. */
    swiper-container:not(:defined) {
        display: flex;
        gap: 12px;
        overflow: hidden;
    }
    swiper-container:not(:defined) > swiper-slide {
        display: block;
        flex-shrink: 0;
    }

    [data-carousel-prev].swiper-button-disabled,
    [data-carousel-next].swiper-button-disabled {
        opacity: 0.4;
        pointer-events: none;
    }
</style>
