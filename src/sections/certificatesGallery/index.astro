---
import Button from "@/components/Button/index.astro";
import Container from "@/components/Container/index.astro";
import Eyebrow from "@/components/Eyebrow/index.astro";
import type { Props } from "./index.type";

const {
    eyebrow = "",
    heading = "",
    certificates = [],
    button,
    surface = "bg",
} = Astro.props as Props;

const pad = (n: number) => String(n).padStart(2, "0");
const cards = certificates
    .map((item) => {
        const certificate = item.certificate ?? item;
        const url = certificate.image?.asset?.url;
        if (!url) return null;
        const extension =
            url.split("?")[0].split(".").pop()?.toLowerCase() ?? "img";
        const title = certificate.title ?? certificate.image?.alt ?? "";
        return {
            title,
            alt: certificate.image?.alt || title || "Certificate preview",
            src: `${url}?w=800&auto=format`,
            full: `${url}?w=2000&auto=format`,
            extension: `.${extension}`,
        };
    })
    .filter((card) => card !== null);

const arrowClass =
    "flex size-12 cursor-pointer items-center justify-center border border-line-strong bg-bg font-mono text-base text-fg transition-colors duration-200 hover:border-acc hover:text-acc";
---

<Container
    className="flex flex-col gap-10 py-[clamp(56px,8vw,112px)]"
>
    <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="flex flex-col gap-3.5">
            {eyebrow && <Eyebrow text={eyebrow} />}
            {
                heading && (
                    <h2 class="m-0 text-[clamp(40px,6vw,72px)] leading-none">
                        {heading}
                    </h2>
                )
            }
        </div>
        <div class="flex items-center gap-2.5" data-carousel-controls>
            {
                cards.length > 1 && (
                    <>
                        <button
                            type="button"
                            class={arrowClass}
                            aria-label="Previous certificate"
                            data-carousel-prev
                        >
                            ←
                        </button>
                        <button
                            type="button"
                            class={arrowClass}
                            aria-label="Next certificate"
                            data-carousel-next
                        >
                            →
                        </button>
                    </>
                )
            }
            {
                button?.buttonText && (
                    <Button
                        variant="outline"
                        surface={surface}
                        href={button.buttonLink}
                        label={button.buttonText}
                        isExternal={button.isExternalLink}
                    />
                )
            }
        </div>
    </div>

    {
        cards.length > 0 && (
            <swiper-container
                class="certificates-swiper -mx-[clamp(20px,4vw,48px)] block px-[clamp(20px,4vw,48px)]"
                init="false"
            >
                {cards.map((card, index) => (
                    <swiper-slide class="w-[min(82%,380px)]!">
                        <button
                            type="button"
                            class="relative block aspect-[16/10] w-full cursor-zoom-in overflow-hidden border border-line bg-surface p-0 transition-colors duration-200 hover:border-acc focus-visible:border-acc"
                            data-lightbox-src={card.full}
                            data-lightbox-title={card.title}
                            aria-label={`Open ${card.title || "certificate"}`}
                        >
                            <img
                                src={card.src}
                                alt={card.alt}
                                class="absolute inset-0 block size-full object-cover object-top"
                                loading="lazy"
                            />
                            <span class="absolute inset-x-0 bottom-0 flex justify-between gap-3 bg-bg/90 px-3.5 py-2.5 text-left font-mono text-xs text-fg">
                                <span>
                                    <span class="text-acc">{pad(index + 1)}</span>{" "}
                                    {card.title}
                                </span>
                                <span class="text-dim">{card.extension}</span>
                            </span>
                        </button>
                    </swiper-slide>
                ))}
            </swiper-container>
        )
    }
</Container>

<script>
    import { register } from "swiper/element/bundle";

    register();

    const initCertificatesSwipers = () => {
        document
            .querySelectorAll<HTMLElement>("swiper-container.certificates-swiper")
            .forEach((swiperEl) => {
                if (swiperEl.dataset.initialized === "true") return;

                const section = swiperEl.closest("section");
                const prevEl = section?.querySelector("[data-carousel-prev]");
                const nextEl = section?.querySelector("[data-carousel-next]");

                Object.assign(swiperEl, {
                    slidesPerView: "auto",
                    spaceBetween: 12,
                    grabCursor: true,
                    keyboard: { enabled: true },
                    navigation:
                        prevEl && nextEl ? { prevEl, nextEl } : false,
                });
                (swiperEl as HTMLElement & { initialize: () => void }).initialize();
                swiperEl.dataset.initialized = "true";
            });
    };

    document.addEventListener("astro:page-load", initCertificatesSwipers);
    initCertificatesSwipers();
</script>

<style>
    [data-carousel-prev].swiper-button-disabled,
    [data-carousel-next].swiper-button-disabled {
        opacity: 0.4;
        pointer-events: none;
    }
</style>
