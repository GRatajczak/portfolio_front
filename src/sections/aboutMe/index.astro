---
import Button from "@/components/Button/index.astro";
import Container from "@/components/Container/index.astro";
import Eyebrow from "@/components/Eyebrow/index.astro";
import ImageGrid from "@/components/ImageGrid/index.astro";
import RichText from "@/components/RichText/index.astro";
import type { Props } from "./index.type";

const {
    eyebrow = "",
    heading = "",
    description = [],
    button,
    images = [],
    surface = "bg",
} = Astro.props as Props;
---

<Container className="py-[clamp(56px,8vw,112px)]">
    <div
        class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-center gap-[clamp(40px,6vw,88px)]"
    >
        <div class="flex flex-col gap-7">
            <div class="flex flex-col gap-3.5">
                {eyebrow && <Eyebrow text={eyebrow} />}
                {
                    heading && (
                        <h2 class="m-0 text-[clamp(40px,6vw,72px)] leading-none">
                            {heading}
                        </h2>
                    )
                }
            </div>
            {
                description.length > 0 && (
                    <RichText
                        value={description}
                        className="flex flex-col gap-7 text-muted [&_p]:m-0 [&_p]:text-[17px]! [&_p]:leading-[1.65]! [&_p]:text-pretty"
                    />
                )
            }
            {
                button?.buttonText && (
                    <div class="flex">
                        <Button
                            variant="outline"
                            surface={surface}
                            href={button.buttonLink}
                            label={button.buttonText}
                            srContext={heading}
                            isExternal={button.isExternalLink}
                        />
                    </div>
                )
            }
        </div>
        <ImageGrid images={images} />
    </div>
</Container>
