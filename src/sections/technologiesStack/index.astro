---
import Container from "@/components/Container/index.astro";
import FileFrame from "@/components/FileFrame/index.astro";
import { getTechnologyLabel } from "@/utils/pageBuilder/helpers";
import type { Props } from "./index.type";

const { technologies = [] } = Astro.props as Props;
const names = technologies.map((item) => getTechnologyLabel(item)).filter(Boolean);
---

{
    names.length > 0 && (
        <Container>
            <FileFrame
                leftLabel="src/stack.ts"
                rightLabel={`${names.length} items`}
                bodyClassName="flex flex-col gap-[18px] p-[clamp(20px,3vw,36px)] font-mono text-[clamp(13px,1.3vw,15px)] text-fg"
            >
                <div>
                    <span class="text-acc">export const</span> stack{" "}
                    <span class="text-dim">=</span> [
                </div>
                <ul class="m-0 flex list-none flex-wrap gap-2.5 p-0 pl-[clamp(12px,3vw,32px)]">
                    {names.map((name) => (
                        <li class="border border-line px-3.5 py-2 text-fg-soft transition-colors duration-200 hover:border-acc hover:text-fg">
                            '{name}'
                        </li>
                    ))}
                </ul>
                <div>
                    ] <span class="text-acc">as const</span>;
                </div>
            </FileFrame>
        </Container>
    )
}
