---
import RichText from "@/components/RichText/index.astro";
import { sanityImage } from "@/utils/sanityImage";
import type { Props } from "./index.type";

const { title, content = [], image, number = "", reverse = false } =
    Astro.props as Props;
const imageUrl = image?.asset?.url;
const dimensions = image?.asset?.metadata?.dimensions;
const responsiveImage =
    imageUrl &&
    sanityImage(imageUrl, {
        sizes: "(max-width: 900px) 100vw, 760px",
        sourceWidth: dimensions?.width,
    });
---

<div
    class:list={[
        "flex flex-wrap items-center gap-[clamp(28px,5vw,64px)]",
        reverse ? "flex-row-reverse" : "flex-row",
    ]}
>
    <div class="flex flex-[1_1_340px] flex-col gap-4">
        {number && <span class="font-mono text-[13px] text-acc">{number}</span>}
        {
            title && (
                <h3 class="m-0 text-[clamp(26px,3vw,38px)] leading-[1.1] tracking-[-.03em]">
                    {title}
                </h3>
            )
        }
        <RichText
            value={content}
            className="flex flex-col gap-4 text-muted [&_p]:m-0 [&_p]:text-base! [&_p]:leading-[1.65]! [&_p]:text-pretty [&_strong]:text-fg"
        />
    </div>
    {
        responsiveImage && (
            <img
                src={responsiveImage.src}
                srcset={responsiveImage.srcset}
                sizes={responsiveImage.sizes}
                alt={image?.alt ?? title ?? "Project image"}
                width={dimensions?.width}
                height={dimensions?.height}
                class="block h-auto w-full min-w-0 flex-[1.4_1_420px] border border-line"
                loading="lazy"
            />
        )
    }
</div>
