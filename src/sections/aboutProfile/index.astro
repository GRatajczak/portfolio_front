---
import Eyebrow from "@/components/Eyebrow/index.astro";
import RichText from "@/components/RichText/index.astro";
import Tag from "@/components/Tag/index.astro";
import { sanityImage } from "@/utils/sanityImage";
import type { Props } from "./index.type";

const {
    image,
    fileLabel = "",
    fileMeta = "",
    captionTitle = "",
    captionSubtitle = "",
    lead = [],
    pathLabel = "",
    path = [],
    facts = [],
} = Astro.props as Props;

const imageUrl = image?.asset?.url;
const portrait =
    imageUrl &&
    sanityImage(imageUrl, {
        sizes: "(max-width: 860px) 100vw, 660px",
        sourceWidth: image?.asset?.metadata?.dimensions?.width,
    });
const pad = (n: number) => String(n).padStart(2, "0");
const bodyClass =
    "flex flex-col gap-3 text-muted [&_p]:m-0 [&_p]:text-base! [&_p]:leading-[1.65]! [&_p]:text-pretty";
---

<section class="mx-auto w-full max-w-[1400px] px-[clamp(20px,4vw,48px)] pb-[clamp(56px,8vw,112px)]">
    <div
        class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] items-start gap-[clamp(32px,5vw,72px)]"
    >
        {
            portrait && (
                <figure class="m-0 flex flex-col border border-line bg-bg-alt min-[760px]:sticky min-[760px]:top-24">
                    {(fileLabel || fileMeta) && (
                        <div class="flex justify-between border-b border-line px-4 py-3 font-mono text-[11px] text-dim">
                            <span>{fileLabel}</span>
                            <span>{fileMeta}</span>
                        </div>
                    )}
                    <img
                        src={portrait.src}
                        srcset={portrait.srcset}
                        sizes={portrait.sizes}
                        alt={image?.alt || captionTitle || "Portrait"}
                        class="block aspect-[4/5] w-full object-cover"
                        loading="lazy"
                    />
                    {captionTitle && (
                        <figcaption class="flex flex-col gap-1.5 border-t border-line p-4 font-mono text-[13px]">
                            <span class="text-dim">$ whoami</span>
                            <span class="text-fg">
                                {captionTitle}
                                {captionSubtitle && (
                                    <span class="text-acc"> · {captionSubtitle}</span>
                                )}
                            </span>
                        </figcaption>
                    )}
                </figure>
            )
        }
        <div class="flex min-w-0 flex-col gap-12">
            {
                lead.length > 0 && (
                    <RichText
                        value={lead}
                        className="text-fg [&_p]:m-0 [&_p]:text-[clamp(24px,2.8vw,34px)]! [&_p]:leading-[1.3]! [&_p]:font-medium [&_p]:tracking-[-.025em] [&_p]:text-pretty"
                    />
                )
            }
            {
                path.length > 0 && (
                    <div class="flex flex-col gap-4">
                        {pathLabel && <Eyebrow text={pathLabel} />}
                        <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-2 p-0">
                            {path.map((step, index) => (
                                <li
                                    class={`flex flex-col gap-2.5 border p-4 ${
                                        step.isCurrent
                                            ? "border-acc bg-bg-alt"
                                            : "border-line"
                                    }`}
                                >
                                    <span
                                        class={`font-mono text-xs ${step.isCurrent ? "text-acc" : "text-dim"}`}
                                    >
                                        {pad(index + 1)} {step.isCurrent ? "● now" : "→"}
                                    </span>
                                    <span class="text-base font-medium">
                                        {step.label}
                                    </span>
                                </li>
                            ))}
                        </ol>
                    </div>
                )
            }
            {
                facts.length > 0 && (
                    <dl class="m-0 flex flex-col border-b border-line">
                        {facts.map((fact) => (
                            <div class="flex flex-wrap gap-x-8 gap-y-2.5 border-t border-line py-[22px]">
                                <dt class="flex-[0_0_120px] font-mono text-[13px] text-dim">
                                    {fact.label}
                                </dt>
                                <dd class="m-0 flex min-w-0 flex-[1_1_280px] flex-col gap-3.5">
                                    {fact.body?.length ? (
                                        <RichText
                                            value={fact.body}
                                            className={bodyClass}
                                        />
                                    ) : null}
                                    {fact.tags?.length ? (
                                        <div class="flex flex-wrap gap-2">
                                            {fact.tags.map((tag) => (
                                                <Tag
                                                    text={tag.text}
                                                    accent={tag.accent}
                                                />
                                            ))}
                                        </div>
                                    ) : null}
                                </dd>
                            </div>
                        ))}
                    </dl>
                )
            }
        </div>
    </div>
</section>
