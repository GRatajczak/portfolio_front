---
import { useTranslations } from "@/i18n/ui";
import Eyebrow from "@/components/Eyebrow/index.astro";
import { sanityImage, sanityImageUrl } from "@/utils/sanityImage";
import type { Props } from "./index.type";

const { eyebrow = "", heading = "", certificates = [] } = Astro.props as Props;

const pad = (n: number) => String(n).padStart(2, "0");
const cards = certificates
    .map((item) => {
        const certificate = item.certificate ?? item;
        const url = certificate.image?.asset?.url;
        if (!url) return null;
        const extension =
            url.split("?")[0].split(".").pop()?.toLowerCase() ?? "img";
        const title = certificate.title ?? certificate.image?.alt ?? "";
        return {
            title,
            alt: certificate.image?.alt || title || "Certificate preview",
            image: sanityImage(url, {
                sizes: "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 340px",
                sourceWidth: certificate.image?.asset?.metadata?.dimensions?.width,
                widths: [320, 480, 640, 800, 960],
            }),
            full: sanityImageUrl(url, 2000),
            extension: `.${extension}`,
        };
    })
    .filter((card) => card !== null);

const { t } = useTranslations(Astro.url);
---

<section class="pt-[clamp(24px,4vw,48px)] pb-[clamp(64px,9vw,120px)]">
    <div
        class="mx-auto flex w-full max-w-[1400px] flex-col gap-10 px-[clamp(20px,4vw,48px)]"
    >
        {
            (eyebrow || heading) && (
                <div class="flex flex-col gap-3.5">
                    {eyebrow && <Eyebrow text={eyebrow} />}
                    {heading && (
                        <h2 class="m-0 text-[clamp(40px,6vw,72px)] leading-none">
                            {heading}
                        </h2>
                    )}
                </div>
            )
        }
        {
            cards.length > 0 && (
                <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,280px),1fr))] gap-2">
                    {cards.map((card, index) => (
                        <button
                            type="button"
                            class="relative block aspect-[16/10] w-full cursor-zoom-in overflow-hidden border border-line bg-surface p-0 transition-colors duration-200 hover:border-acc focus-visible:border-acc"
                            data-lightbox-src={card.full}
                            data-lightbox-title={card.title}
                        >
                            <img
                                src={card.image.src}
                                srcset={card.image.srcset}
                                sizes={card.image.sizes}
                                alt={card.title ? "" : card.alt}
                                class="absolute inset-0 block size-full object-cover object-top"
                                loading="lazy"
                            />
                            <span class="sr-only">{t("certificates.open")}: </span>
                            <span class="absolute inset-x-0 bottom-0 flex justify-between gap-3 bg-bg/90 px-3.5 py-2.5 text-left font-mono text-xs text-fg">
                                <span>
                                    <span class="text-acc">{pad(index + 1)}</span>{" "}
                                    {card.title}
                                </span>
                                <span class="text-dim">{card.extension}</span>
                            </span>
                        </button>
                    ))}
                </div>
            )
        }
    </div>
</section>
