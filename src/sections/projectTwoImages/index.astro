---
import { sanityImage } from "@/utils/sanityImage";
import type { Props } from "./index.type";

const { leftImage, rightImage } = Astro.props as Props;

const images = [
    { image: leftImage, fallbackAlt: "Project image left" },
    { image: rightImage, fallbackAlt: "Project image right" },
].flatMap(({ image, fallbackAlt }) =>
    image?.asset?.url
        ? [
              {
                  image,
                  fallbackAlt,
                  ...sanityImage(image.asset.url, {
                      sizes: "(max-width: 860px) 100vw, 650px",
                      sourceWidth: image.asset.metadata?.dimensions?.width,
                  }),
              },
          ]
        : [],
);
---

{
    images.length > 0 && (
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] items-start gap-4">
            {images.map(({ image, fallbackAlt, src, srcset, sizes }) => (
                <img
                    src={src}
                    srcset={srcset}
                    sizes={sizes}
                    alt={image?.alt ?? fallbackAlt}
                    width={image?.asset?.metadata?.dimensions?.width}
                    height={image?.asset?.metadata?.dimensions?.height}
                    class="block h-auto w-full border border-line"
                    loading="lazy"
                />
            ))}
        </div>
    )
}
