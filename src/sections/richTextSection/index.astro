---
import RichText from "@/components/RichText/index.astro";
import type { Props } from "./index.type";

const { content = [], narrow = true } = Astro.props as Props;
const baseClass =
    "flex flex-col gap-5 text-muted [&_a]:text-acc [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:border-l-2 [&_blockquote]:border-line-strong [&_blockquote]:pl-4 [&_blockquote]:italic [&_h2]:text-[clamp(26px,3vw,38px)]! [&_h2]:leading-[1.1]! [&_h2]:tracking-[-.03em] [&_h3]:text-[clamp(26px,3vw,38px)]! [&_h3]:leading-[1.1]! [&_h3]:tracking-[-.03em] [&_p]:m-0 [&_p]:text-base! [&_p]:leading-[1.7]! [&_p]:text-pretty [&_strong]:text-fg";
---

{
    content.length > 0 && (
        <RichText
            value={content}
            className={`${baseClass}${narrow ? " max-w-[820px]" : ""}`}
        />
    )
}
