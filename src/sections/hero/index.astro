---
import { Image } from "astro:assets";
import type { Props } from "./index.type";

const {
    headline = "",
    subheadline = [],
    portraitImage,
    mobileImage,
} = Astro.props as Props;
const phrases = subheadline.map((item) => item.text).filter(Boolean) as string[];
const portraitImageUrl = portraitImage?.asset?.url ?? mobileImage?.asset?.url;
const portraitImageWidth =
    portraitImage?.asset?.metadata?.dimensions?.width ?? 900;
const portraitImageHeight =
    portraitImage?.asset?.metadata?.dimensions?.height ?? 1200;
const portraitImageAlt = portraitImage?.alt || "Portrait photo";
const mobileImageUrl = mobileImage?.asset?.url;
const mobileImageWidth =
    mobileImage?.asset?.metadata?.dimensions?.width ?? portraitImageWidth;
const mobileImageHeight =
    mobileImage?.asset?.metadata?.dimensions?.height ?? portraitImageHeight;
const cornerClass = "absolute size-7 border-acc";
---

<section class="relative">
    <div
        class="bg-grid pointer-events-none absolute inset-0 [mask-image:linear-gradient(to_bottom,#000_45%,transparent)]"
        aria-hidden="true"
    >
    </div>
    <div
        class="relative mx-auto grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-end gap-12 px-[clamp(20px,4vw,48px)] pt-[clamp(48px,8vw,96px)] pb-[clamp(32px,5vw,72px)]"
    >
        <div class="flex flex-col gap-7 pb-[clamp(56px,9vw,128px)]">
            <span class="font-mono text-[14px] text-muted">
                <span class="text-acc">$</span> whoami
            </span>
            {
                headline && (
                    <h1 class="m-0 text-[clamp(56px,9vw,124px)] leading-[.92] tracking-[-.05em] text-balance">
                        {headline}
                    </h1>
                )
            }
            {
                phrases.length > 0 && (
                    <div
                        class="flex min-h-8 items-center gap-2.5 font-mono text-[clamp(16px,1.8vw,22px)] text-fg"
                        data-typing={JSON.stringify(phrases)}
                    >
                        <span class="text-acc">&gt;</span>
                        <span data-typing-text>{phrases[0]}</span>
                        <span
                            class="h-6 w-[11px] animate-blink bg-acc"
                            aria-hidden="true"
                        />
                    </div>
                )
            }
        </div>
        {
            portraitImageUrl && (
                <div class="relative w-[min(100%,460px)] justify-self-center">
                    <div class={`${cornerClass} top-0 left-0 border-t-2 border-l-2`} />
                    <div class={`${cornerClass} top-0 right-0 border-t-2 border-r-2`} />
                    <picture>
                        {mobileImageUrl && (
                            <source
                                media="(max-width: 759px)"
                                srcset={mobileImageUrl}
                                width={mobileImageWidth}
                                height={mobileImageHeight}
                            />
                        )}
                        <Image
                            src={portraitImageUrl}
                            alt={portraitImageAlt}
                            width={portraitImageWidth}
                            height={portraitImageHeight}
                            class="block h-auto w-full box-border px-6 pt-6 [filter:grayscale(.15)_contrast(1.05)]"
                            loading="eager"
                            format="webp"
                        />
                    </picture>
                    <div class="absolute inset-x-0 bottom-0 h-[30%] bg-gradient-to-b from-transparent to-bg" />
                </div>
            )
        }
    </div>
</section>

<script>
    import { initTyping } from "@/scripts/typing";
    initTyping();
</script>
