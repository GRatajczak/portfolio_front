---
import type { Props } from "./index.type";

const {
    href = "",
    label = "",
    type = "button",
    isExternal = false,
    className = "",
    variant = "primary",
    surface = "bg",
    size = "md",
    showArrowUp = false,
    mobileIconOnly = false,
    srContext = "",
} = Astro.props as Props;

const isOutline = variant === "outline";
const Tag = href ? "a" : "button";
const linkProps = href
    ? {
          href,
          target: isExternal ? "_blank" : undefined,
          rel: isExternal ? "noreferrer noopener" : undefined,
      }
    : { type };

const base = "relative overflow-hidden font-mono font-semibold cursor-pointer";
const primaryClass = `${base} inline-block bg-acc text-bg focus-visible:bg-fg ${
    size === "sm"
        ? "clip-corner-sm px-5 py-[11px] text-[13px]"
        : "clip-corner px-[26px] py-[14px] text-sm"
}`;
const outlineClass = `${base} block bg-line-strong p-px transition-colors duration-200 hover:bg-acc focus-visible:bg-acc clip-corner`;
const innerClass = `block ${
    surface === "bg-alt" ? "bg-bg-alt" : "bg-bg"
} px-[26px] py-[14px] text-sm font-medium text-fg [clip-path:polygon(0_0,calc(100%_-_13.5px)_0,100%_13.5px,100%_100%,13.5px_100%,0_calc(100%_-_13.5px))]`;
---

<Tag
    class={`${isOutline ? outlineClass : primaryClass} ${className}`}
    data-matrix="btn"
    {...linkProps}
>
    {
        isOutline ? (
            <span class={innerClass}>
                <span class={mobileIconOnly ? "sr-only md:not-sr-only" : ""}>
                    <slot>{label}</slot>
                </span>
                {srContext && <span class="sr-only">: {srContext}</span>}
                {showArrowUp && <span aria-hidden="true"> ↗</span>}
            </span>
        ) : (
            <>
                <span class={mobileIconOnly ? "sr-only md:not-sr-only" : ""}>
                    <slot>{label}</slot>
                </span>
                {srContext && <span class="sr-only">: {srContext}</span>}
                {showArrowUp && <span aria-hidden="true"> ↗</span>}
            </>
        )
    }
</Tag>
