---
import { useTranslations } from "@/i18n/ui";
import Button from "@/components/Button/index.astro";
import Link from "@/components/Link/index.astro";
import RichText from "@/components/RichText/index.astro";
import StatusDot from "@/components/StatusDot/index.astro";
import { statusFromCategory } from "@/components/StatusDot/index.type";
import Tag from "@/components/Tag/index.astro";
import { toPlainText } from "@/utils/pageBuilder/helpers";
import type { Props } from "./index.type";

const {
    project,
    variant = "rows",
    index = 0,
    total = 1,
    className = "",
} = Astro.props as Props;

const pad = (n: number) => String(n).padStart(2, "0");
const status = statusFromCategory(project.category);
const technologies = (project.technologies ?? []).flatMap((item) =>
    item.technology?.name
        ? [{ name: item.technology.name, svg: item.technology.svg }]
        : [],
);
const imageUrl = project.image?.asset?.url;
const imageAlt = project.image?.alt || project.title || "Project image";
const fileLabel = `${project.slug ?? "project"}.preview.png`;
const indexLabel =
    variant === "rows" ? `${pad(index + 1)} / ${pad(total)}` : pad(index + 1);
const projectUrl = project.projectUrl;
const caseStudyUrl =
    project.hasCaseStudy && project.slug ? `/work/${project.slug}` : null;
const content = project.content?.length ? project.content : null;
const lead = content
    ? toPlainText(content.slice(0, 1))
    : (project.description ?? "");
const paragraphClass =
    "flex flex-col gap-4 text-muted [&_p]:m-0 [&_p]:text-base! [&_p]:leading-[1.65]! [&_p]:text-pretty";

const { t } = useTranslations(Astro.url);
---

{
    variant === "grid" ? (
        <article
            class={`flex flex-col border border-line bg-bg-alt ${className}`}
        >
            <div class="flex justify-between border-b border-line px-4 py-3 font-mono text-[11px] text-dim">
                <span>{fileLabel}</span>
                <span>{indexLabel}</span>
            </div>
            {imageUrl && (
                <img
                    src={imageUrl}
                    alt={imageAlt}
                    class="block aspect-[3/2] w-full object-cover"
                    loading="lazy"
                />
            )}
            <div class="flex flex-1 flex-col gap-4 p-[clamp(20px,2.5vw,28px)]">
                <StatusDot status={status} />
                {project.title && (
                    <h3 class="m-0 text-[clamp(26px,3vw,34px)] tracking-[-.03em]">
                        {project.title}
                    </h3>
                )}
                {lead && (
                    <p class="m-0 text-[15px]! leading-[1.6]! text-pretty text-muted">
                        {lead}
                    </p>
                )}
                {technologies.length > 0 && (
                    <div class="mt-auto flex flex-wrap gap-2">
                        {technologies.map(({ name, svg }) => (
                            <Tag text={name} svg={svg} />
                        ))}
                    </div>
                )}
                <div class="flex flex-wrap gap-x-6 gap-y-2">
                    {projectUrl && (
                        <Link
                            href={projectUrl}
                            isExternal
                            font="mono"
                            className="text-sm text-acc"
                        >
                            {t("project.seeLive")} ↗
                        </Link>
                    )}
                    {caseStudyUrl && (
                        <Link
                            href={caseStudyUrl}
                            font="mono"
                            className="text-sm text-acc"
                        >
                            {t("project.seeCaseStudy")} →
                        </Link>
                    )}
                </div>
            </div>
        </article>
    ) : (
        <article
            class={`grid grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] items-center gap-[clamp(28px,5vw,64px)] ${className}`}
        >
            <div class="relative border border-line bg-surface p-2.5">
                <div class="flex justify-between px-1 pt-0.5 pb-2.5 font-mono text-[11px] text-dim">
                    <span>{fileLabel}</span>
                    <span>{indexLabel}</span>
                </div>
                {imageUrl ? (
                    <img
                        src={imageUrl}
                        alt={imageAlt}
                        class="block aspect-[3/2] w-full object-cover"
                        loading="lazy"
                    />
                ) : (
                    <div class="flex aspect-[3/2] items-center justify-center font-mono text-xs text-dim">
                        no preview
                    </div>
                )}
            </div>
            <div class="flex flex-col gap-[22px]">
                <StatusDot status={status} />
                {project.title && (
                    <h3 class="m-0 text-[clamp(30px,4vw,44px)] leading-[1.05] tracking-[-.035em]">
                        {project.title}
                    </h3>
                )}
                <RichText
                    value={content ?? project.description ?? ""}
                    className={paragraphClass}
                />
                {technologies.length > 0 && (
                    <div class="flex flex-col gap-2.5">
                        <span class="font-mono text-xs text-dim">
                            {t("project.technologies")}
                        </span>
                        <div class="flex flex-wrap gap-2">
                            {technologies.map(({ name, svg }) => (
                                <Tag text={name} svg={svg} />
                            ))}
                        </div>
                    </div>
                )}
                <div class="flex flex-wrap gap-3">
                    {projectUrl && (
                        <Button
                            href={projectUrl}
                            isExternal
                            label={`${t("project.seeLive")} ↗`}
                        />
                    )}
                    {caseStudyUrl && (
                        <Button href={caseStudyUrl} label={`${t("project.seeCaseStudy")} →`} />
                    )}
                </div>
            </div>
        </article>
    )
}
