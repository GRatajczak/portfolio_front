---
import type { Props } from "./index.type";

const {
    leftLabel = "",
    rightLabel = "",
    className = "",
    bodyClassName = "",
} = Astro.props as Props;
---

<div class={`border border-line bg-surface ${className}`}>
    <div
        class="flex items-center justify-between border-b border-line px-5 py-3 font-mono text-xs text-dim"
    >
        <span>{leftLabel}</span>
        <span>{rightLabel}</span>
    </div>
    <div class={bodyClassName}>
        <slot />
    </div>
</div>
