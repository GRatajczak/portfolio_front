---
import TabDivider from "@/components/TabDivider/index.astro";
import type { FooterMenuItem, Props } from "./index.type";
import Link from "@/components/Link/index.astro";

const {
    menuItems = [],
    phone = "",
    email = "",
    instagram = "",
    linkedin = "",
    github = "",
} = Astro.props as Props;

type ResolvedFooterMenuItem = FooterMenuItem & {
    title: string;
    slug: string;
};

const resolvedMenuItems: ResolvedFooterMenuItem[] = menuItems.flatMap(
    (item) => {
        if (!item?.title || !item?.slug) {
            return [];
        }

        return [{ ...item, title: item.title, slug: item.slug }];
    },
);

const localePrefix = Astro.url.pathname.startsWith("/pl") ? "/pl" : "";
const homeHref = localePrefix || "/";

const getHref = (slug: string) => {
    if (slug.startsWith("http://") || slug.startsWith("https://")) {
        return slug;
    }

    if (slug.startsWith("/") || slug.startsWith("#")) {
        return slug;
    }

    const localizedSlug =
        localePrefix === "/pl" && slug.endsWith("-pl")
            ? slug.slice(0, -3)
            : slug;

    if (localizedSlug === "home") {
        return homeHref;
    }

    if (!localePrefix) {
        return `/${localizedSlug}`;
    }

    return `${localePrefix}/${localizedSlug}`;
};

const privacyPolicyHref = localePrefix
    ? `${localePrefix}/privacy-policy`
    : "/privacy-policy";

const socials = [
    { label: "LinkedIn", href: linkedin },
    { label: "Instagram", href: instagram },
    { label: "GitHub", href: github },
].filter((social) => social.href);

const currentYear = new Date().getFullYear();
---

<TabDivider label="footer.tsx" from="bg" to="bg-alt" className="footer-tab" />
<footer class="mt-auto bg-bg-alt">
    <div
        class="mx-auto grid w-full max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-12 px-[clamp(20px,4vw,48px)] pt-[clamp(56px,8vw,96px)]"
    >
        <div class="flex flex-col gap-[22px]">
            <a
                href={homeHref}
                aria-label="Go to homepage"
                data-matrix="link"
                class="font-mono text-lg font-medium"
            >
                <span class="text-acc">~/</span>ratajczak
            </a>
            <div class="flex flex-col gap-2.5 font-mono text-[13px]">
                {
                    socials.map((social) => (
                        <Link
                            href={social.href}
                            isExternal
                            font="mono"
                            className="w-fit text-muted"
                        >
                            {social.label} ↗
                        </Link>
                    ))
                }
            </div>
        </div>

        <div class="flex flex-col gap-4">
            <span class="font-mono text-xs text-acc">// Quick links</span>
            <ul class="flex flex-col gap-2.5 font-mono text-[13px]">
                {
                    resolvedMenuItems.map((item) => (
                        <li>
                            <Link
                                href={getHref(item.slug)}
                                font="mono"
                                className="w-fit text-muted"
                            >
                                {item.title}
                            </Link>
                        </li>
                    ))
                }
                <li>
                    <Link
                        href={`${localePrefix}/contact`}
                        font="mono"
                        className="w-fit text-muted"
                    >
                        Contact
                    </Link>
                </li>
            </ul>
        </div>

        {
            (phone || email) && (
                <div class="flex flex-col gap-4">
                    <span class="font-mono text-xs text-acc">// Contact</span>
                    <ul class="flex flex-col gap-2.5 font-mono text-[13px]">
                        {phone && (
                            <li>
                                <Link
                                    href={`tel:${phone}`}
                                    font="mono"
                                    className="w-fit text-muted"
                                >
                                    {phone}
                                </Link>
                            </li>
                        )}
                        {email && (
                            <li>
                                <Link
                                    href={`mailto:${email}`}
                                    font="mono"
                                    className="w-fit text-muted"
                                >
                                    {email}
                                </Link>
                            </li>
                        )}
                    </ul>
                </div>
            )
        }
    </div>
    <div
        class="mx-auto w-full max-w-[1240px] px-[clamp(20px,4vw,48px)] pt-14 pb-7"
    >
        <div
            class="flex flex-wrap justify-between gap-4 border-t border-line pt-5 font-mono text-xs text-dim"
        >
            <span>© {currentYear} | Grzegorz Ratajczak</span>
            <div class="flex gap-6">
                <span>Poland</span>
                <Link href={privacyPolicyHref} font="mono" className="text-dim">
                    Privacy Policy
                </Link>
            </div>
        </div>
    </div>
</footer>
