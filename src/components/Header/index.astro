---
import { useTranslations } from "@/i18n/ui";
import type { HeaderMenuItem, Props } from "./index.type";
import Link from "@/components/Link/index.astro";
import Button from "@/components/Button/index.astro";
import MobileMenu from "./MobileMenu.astro";
const {
    menuItems = [],
    linkedin = "",
    github = "",
    instagram = "",
} = Astro.props as Props;

const { t } = useTranslations(Astro.url);

type ResolvedHeaderMenuItem = HeaderMenuItem & {
    title: string;
    slug: string;
};

const sanitizedMenuItems: ResolvedHeaderMenuItem[] = menuItems.flatMap(
    (item) => {
        if (!item?.title || !item?.slug) {
            return [];
        }

        return [{ ...item, title: item.title, slug: item.slug }];
    },
);

const localePrefix = Astro.url.pathname.startsWith("/pl") ? "/pl" : "";
const homeHref = localePrefix || "/";

const getHref = (slug: string) => {
    if (slug.startsWith("http://") || slug.startsWith("https://")) {
        return slug;
    }

    if (slug.startsWith("/") || slug.startsWith("#")) {
        return slug;
    }

    const localizedSlug =
        localePrefix === "/pl" && slug.endsWith("-pl")
            ? slug.slice(0, -3)
            : slug;

    if (localizedSlug === "home") {
        return homeHref;
    }

    if (!localePrefix) {
        return `/${localizedSlug}`;
    }

    return `${localePrefix}/${localizedSlug}`;
};

const normalizePath = (path: string) => {
    const withoutLocale = path.replace(/^\/pl(?=\/|$)/, "") || "/";
    return withoutLocale.length > 1
        ? withoutLocale.replace(/\/$/, "")
        : withoutLocale;
};
const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href: string) => {
    if (href.startsWith("http") || href.startsWith("#")) return false;
    const target = normalizePath(href);
    return (
        currentPath === target ||
        (target !== "/" && currentPath.startsWith(`${target}/`))
    );
};

const navigationItems = sanitizedMenuItems.map((item) => ({
    title: item.title,
    href: getHref(item.slug),
}));
const contactHref = `${localePrefix}/contact`;
const mobileMenuItems = [
    { title: t("nav.home"), href: homeHref, active: currentPath === "/" },
    ...navigationItems.map((item) => ({ ...item, active: isActive(item.href) })),
];
const socials = [
    { label: "LinkedIn", href: linkedin },
    { label: "GitHub", href: github },
    { label: "Instagram", href: instagram },
].filter((social) => social.href);
---

<header
    class="fixed top-0 left-0 z-20 w-full border-b border-line bg-bg/82 backdrop-blur-md"
    data-desktop-header
>
    <nav
        class="header-nav mx-auto flex h-[72px] w-full max-w-full items-center justify-between gap-6 px-[clamp(20px,4vw,48px)] transition-[max-width] duration-300 ease-out"
        data-desktop-header-nav
    >
        <a
            href={homeHref}
            data-matrix="link"
            class="flex items-center gap-0.5 font-mono text-[15px] font-medium"
        >
            <span class="text-acc">~/</span><span>ratajczak</span><span
                class="sr-only">, {t("nav.homeAria")}</span><span
                class="ml-1 h-4 w-2 animate-blink bg-acc"
                aria-hidden="true"></span>
        </a>

        {
            sanitizedMenuItems.length > 0 && (
                <>
                    <button
                        type="button"
                        class="-mr-2.5 flex size-11 flex-col items-center justify-center gap-1.5 min-[760px]:hidden"
                        aria-label={t("nav.menuAria")}
                        aria-expanded="false"
                        aria-controls="mobile-menu-panel"
                        data-mobile-menu-toggle
                    >
                        <span
                            class="block h-0.5 w-[22px] bg-fg transition-transform duration-200"
                            data-menu-bar="1"></span>
                        <span
                            class="block h-0.5 w-[22px] bg-acc transition-transform duration-200"
                            data-menu-bar="2"></span>
                    </button>

                    <div class="hidden items-center gap-[clamp(14px,3vw,36px)] min-[760px]:flex">
                        <ul class="flex flex-wrap items-center justify-end gap-[clamp(14px,3vw,36px)]">
                            {navigationItems.map((item, index) => (
                                <li>
                                    <Link
                                        href={item.href}
                                        font="mono"
                                        className={`flex gap-1.5 text-[13px] leading-none ${isActive(item.href) ? "text-fg" : "text-muted"}`}
                                    >
                                        <span class="text-acc">
                                            {String(index + 1).padStart(2, "0")}.
                                        </span>
                                        <span>{item.title}</span>
                                    </Link>
                                </li>
                            ))}
                        </ul>
                        <Button href={contactHref} size="sm">
                            {t("nav.getInTouch")}
                        </Button>
                    </div>
                </>
            )
        }
    </nav>
</header>

{
    sanitizedMenuItems.length > 0 && (
        <MobileMenu
            menuItems={mobileMenuItems}
            contactHref={contactHref}
            socials={socials}
        />
    )
}

<script>
    const setupMobileMenu = () => {
        const toggleButton = document.querySelector<HTMLButtonElement>(
            "[data-mobile-menu-toggle]",
        );
        const menuPanel = document.querySelector<HTMLElement>(
            "[data-mobile-menu-panel]",
        );
        const header = document.querySelector("[data-desktop-header]");

        if (!toggleButton || !menuPanel) {
            return () => {};
        }

        const bars = toggleButton.querySelectorAll<HTMLElement>(
            "[data-menu-bar]",
        );
        const menuLinks = menuPanel.querySelectorAll("a[href]:not([target])");

        const setOpen = (open: boolean) => {
            toggleButton.setAttribute("aria-expanded", String(open));
            menuPanel.hidden = !open;
            document.documentElement.style.overflow = open ? "hidden" : "";
            if (bars[0] && bars[1]) {
                bars[0].style.transform = open
                    ? "translateY(4px) rotate(45deg)"
                    : "";
                bars[1].style.transform = open
                    ? "translateY(-4px) rotate(-45deg)"
                    : "";
            }
        };
        const closeMenu = () => setOpen(false);

        const onToggleClick = () =>
            setOpen(toggleButton.getAttribute("aria-expanded") !== "true");

        const onResize = () => {
            if (window.innerWidth >= 760) closeMenu();
        };

        const onKeyDown = (event: KeyboardEvent) => {
            if (event.key === "Escape") closeMenu();
        };

        const onTouchMove = (event: TouchEvent) => {
            if (menuPanel.hidden) return;
            if (header?.contains(event.target as Node)) return;
            event.preventDefault();
        };

        toggleButton.addEventListener("click", onToggleClick);
        menuLinks.forEach((link) => link.addEventListener("click", closeMenu));
        window.addEventListener("resize", onResize);
        window.addEventListener("keydown", onKeyDown);
        document.addEventListener("touchmove", onTouchMove, { passive: false });
        document.addEventListener("astro:before-swap", closeMenu);

        return () => {
            toggleButton.removeEventListener("click", onToggleClick);
            menuLinks.forEach((link) =>
                link.removeEventListener("click", closeMenu),
            );
            window.removeEventListener("resize", onResize);
            window.removeEventListener("keydown", onKeyDown);
            document.removeEventListener("touchmove", onTouchMove);
            document.removeEventListener("astro:before-swap", closeMenu);
            document.documentElement.style.overflow = "";
        };
    };

    const setupHeaderScroll = () => {
        const header = document.querySelector("[data-desktop-header]");
        if (!header) {
            return () => {};
        }

        const update = () => {
            header.toggleAttribute("data-scrolled", window.scrollY > 24);
        };

        update();
        window.addEventListener("scroll", update, { passive: true });

        return () => {
            window.removeEventListener("scroll", update);
        };
    };

    let cleanupHeaderScroll = () => {};
    let cleanupMobileMenu = () => {};

    const initializeHeaderScripts = () => {
        cleanupMobileMenu();
        cleanupHeaderScroll();

        cleanupMobileMenu = setupMobileMenu();
        cleanupHeaderScroll = setupHeaderScroll();
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeHeaderScripts, {
            once: true,
        });
    } else {
        initializeHeaderScripts();
    }

    document.addEventListener("astro:page-load", initializeHeaderScripts);
</script>

<style>
    @media (min-width: 760px) {
        [data-desktop-header][data-scrolled] .header-nav {
            max-width: 1400px;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .header-nav {
            transition: none;
        }
    }
</style>
