---
import { useTranslations } from "@/i18n/ui";
import type { Props } from "./index.type";

const { status = "done", className = "" } = Astro.props as Props;

const { t } = useTranslations(Astro.url);
---

<span
    class={`flex items-center gap-2 font-mono text-xs text-muted ${className}`}
>
    <span
        class={`size-2 rounded-full ${status === "done" ? "bg-acc" : "bg-going"}`}
        aria-hidden="true"></span>
    {t("status.label")} {status === "done" ? t("status.done") : t("status.inProgress")}
</span>
