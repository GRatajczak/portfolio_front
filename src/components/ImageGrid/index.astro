---
import { sanityImage } from "@/utils/sanityImage";
import type { Props } from "./index.type";

const { images = [], className = "" } = Astro.props as Props;
const visibleImages = images.slice(0, 3);

// Design: [0] 3/4 aligned to the end of its row, [1] 2/3 spanning both rows, [2] 3/2.
const itemClass = [
    "aspect-[3/4] self-end",
    "row-span-2 aspect-[2/3]",
    "aspect-[3/2]",
];
---

{
    visibleImages.length > 0 ? (
        <ul
            class={`m-0 grid list-none grid-cols-[1fr_1.15fr] grid-rows-[auto_auto] gap-3.5 p-0 ${className}`}
        >
            {visibleImages.map((image, index) => {
                const imageUrl = image.asset?.url;
                const imageWidth = image.asset?.metadata?.dimensions?.width;
                const imageHeight = image.asset?.metadata?.dimensions?.height;

                if (!imageUrl || imageWidth == null || imageHeight == null) {
                    return null;
                }

                const { src, srcset, sizes } = sanityImage(imageUrl, {
                    sizes: "(max-width: 860px) 50vw, 360px",
                    sourceWidth: imageWidth,
                });

                return (
                    <li class={`overflow-hidden ${itemClass[index]}`}>
                        <img
                            src={src}
                            srcset={srcset}
                            sizes={sizes}
                            alt={image.alt || "About me image"}
                            width={imageWidth}
                            height={imageHeight}
                            class="block size-full object-cover"
                            loading="lazy"
                            decoding="async"
                        />
                    </li>
                );
            })}
        </ul>
    ) : null
}
