---
import type { Props } from "./index.type";

const { text = "", svg = "", accent = false, className = "" } = Astro.props as Props;
---

<span
    class={`inline-flex items-center gap-2 border px-2.5 py-[5px] font-mono text-xs leading-none text-fg-soft ${
        accent ? "border-acc" : "border-tag-border"
    } ${className}`}
>
    {
        svg && (
            <span
                aria-hidden="true"
                class="flex shrink-0 items-center [&_svg]:size-3.5"
                set:html={svg}
            />
        )
    }
    <slot>{text}</slot>
</span>
