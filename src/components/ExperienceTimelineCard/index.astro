---
import Tag from "@/components/Tag/index.astro";
import { getTechnologyLabel, toPlainText } from "@/utils/pageBuilder/helpers";
import type { Props } from "./index.type";

const {
    entry,
    isHead = false,
    periodLabel,
    kind,
    duration,
} = Astro.props as Props;

const technologies = entry.technologies ?? [];
const description = toPlainText(entry.description);
---

<article
    class="flex flex-wrap gap-x-[clamp(24px,4vw,64px)] gap-y-4 border-t border-line py-9"
>
    <div class="flex basis-[220px] flex-col gap-2.5">
        <span
            class:list={[
                "font-mono text-[clamp(26px,3vw,34px)] font-medium tracking-[-.03em]",
                isHead ? "text-acc" : "text-fg",
            ]}
        >
            {periodLabel}
        </span>
        <span class="font-mono text-xs text-dim">
            {kind === "support" ? "it support" : "development"} · {duration}
        </span>
    </div>
    <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-3.5">
        <div class="flex flex-wrap items-baseline gap-x-3.5 gap-y-1.5">
            <h3
                class="text-[clamp(22px,2.6vw,30px)] font-semibold tracking-[-.025em]"
            >
                {entry.role}
            </h3>
            <span class="font-mono text-sm text-acc">@ {entry.company}</span>
            {
                isHead && (
                    <span class="border border-acc px-2 py-[3px] font-mono text-[11px] text-fg">
                        HEAD
                    </span>
                )
            }
        </div>
        {
            description && (
                <p class="max-w-[680px] text-base leading-[1.65] text-muted [text-wrap:pretty]">
                    {description}
                </p>
            )
        }
        {
            technologies.length > 0 && (
                <ul class="flex flex-wrap gap-2">
                    {technologies.map((item) => (
                        <li>
                            <Tag text={getTechnologyLabel(item)} svg={item.technology?.svg} />
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
</article>
