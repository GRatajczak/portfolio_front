---
import { useTranslations } from "@/i18n/ui";
// One lightbox per page. Any element with `data-lightbox-src` (and optional
// `data-lightbox-title`) opens it on click.

const { t } = useTranslations(Astro.url);
---

<dialog
    id="lightbox"
    aria-label={t("lightbox.aria")}
    class="m-0 size-full max-h-none max-w-none cursor-zoom-out bg-[rgba(5,5,7,.92)] p-8 backdrop:bg-transparent open:flex open:flex-col open:items-center open:justify-center open:gap-4"
>
    <img
        data-lightbox-image
        alt=""
        class="block max-h-[80vh] max-w-[min(1100px,100%)] border border-line object-contain opacity-0 transition-opacity duration-200 data-[loaded]:opacity-100"
    />
    <span
        data-lightbox-caption
        class="font-mono text-[13px] text-muted opacity-0 transition-opacity duration-200 [dialog:has([data-loaded])_&]:opacity-100"
    ></span>
</dialog>

<script>
    const getDialog = () =>
        document.querySelector<HTMLDialogElement>("#lightbox");

    const open = (trigger: HTMLElement) => {
        const dialog = getDialog();
        const image = dialog?.querySelector<HTMLImageElement>(
            "[data-lightbox-image]",
        );
        const caption = dialog?.querySelector<HTMLElement>(
            "[data-lightbox-caption]",
        );
        const src = trigger.dataset.lightboxSrc;
        if (!dialog || !image || !caption || !src) return;

        const title = trigger.dataset.lightboxTitle ?? "";
        image.removeAttribute("data-loaded");
        image.onload = () => image.setAttribute("data-loaded", "");
        image.src = src;
        image.alt = title;
        caption.textContent = title ? `${title} · esc` : "esc";
        if (!dialog.open) dialog.showModal();
    };

    // Document-level delegation: registered once, survives View Transitions.
    document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        const trigger = target?.closest<HTMLElement>("[data-lightbox-src]");
        if (trigger) {
            event.preventDefault();
            open(trigger);
            return;
        }
        // Click on the backdrop / image area closes (Esc is native).
        const dialog = getDialog();
        if (dialog?.open && target?.closest("#lightbox")) dialog.close();
    });

    // `close` doesn't bubble, so capture it: covers Esc, backdrop click and
    // before-swap. Drops the old image so it can't flash on the next open.
    document.addEventListener(
        "close",
        (event) => {
            const target = event.target as HTMLElement | null;
            if (target?.id !== "lightbox") return;
            const image = target.querySelector<HTMLImageElement>(
                "[data-lightbox-image]",
            );
            if (!image) return;
            image.onload = null;
            image.removeAttribute("data-loaded");
            image.removeAttribute("src");
        },
        true,
    );

    document.addEventListener("astro:before-swap", () => {
        const dialog = getDialog();
        if (dialog?.open) dialog.close();
    });
</script>
