---
import "../styles/global.css";
import Header from "@/components/Header/index.astro";
import Footer from "@/components/Footer/index.astro";
import Lightbox from "@/components/Lightbox/index.astro";
import type { Props } from "./Layout.type";
import { ClientRouter } from "astro:transitions";
import { PUBLIC_SITE_URL } from "astro:env/client";
import { useTranslations } from "@/i18n/ui";
import { buildSeo } from "@/utils/seo";
const {
    title,
    description,
    ogImage,
    noindex = false,
    noAlternates = false,
    headerMenuItems = [],
    footerMenuItems = [],
    phone = "",
    email = "",
    instagram = "",
    linkedin = "",
    github = "",
} = Astro.props as Props;

const { locale, t } = useTranslations(Astro.url);
const seo = buildSeo({
    siteUrl: PUBLIC_SITE_URL,
    pathname: Astro.url.pathname,
    siteName: t("seo.siteName"),
    title,
    description: description || t("seo.description"),
    ogImage,
    noAlternates,
});
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{seo.title}</title>
        <meta name="description" content={seo.description} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        {seo.canonical && <link rel="canonical" href={seo.canonical} />}
        {
            seo.alternates.map((alt) => (
                <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
            ))
        }
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={seo.siteName} />
        <meta property="og:title" content={seo.title} />
        <meta property="og:description" content={seo.description} />
        <meta property="og:locale" content={locale === "pl" ? "pl_PL" : "en_US"} />
        {seo.canonical && <meta property="og:url" content={seo.canonical} />}
        {ogImage && <meta property="og:image" content={ogImage} />}
        <meta
            name="twitter:card"
            content={ogImage ? "summary_large_image" : "summary"}
        />
        <meta name="twitter:title" content={seo.title} />
        <meta name="twitter:description" content={seo.description} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}
    </head>
    <body class="flex min-h-screen flex-col pt-[72px] antialiased">
        <Header
            menuItems={headerMenuItems}
            linkedin={linkedin}
            github={github}
            instagram={instagram}
        />
        <slot />
        <Footer
            menuItems={footerMenuItems}
            phone={phone}
            email={email}
            instagram={instagram}
            linkedin={linkedin}
            github={github}
        />
        <Lightbox />
        <ClientRouter />
    </body>
</html>

<script>
    import { initMatrix } from "@/scripts/matrix";

    initMatrix();
</script>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
