---
import Layout from "../layouts/Layout.astro";
import ContactForm from "@/sections/contactForm/index.astro";
import Subhero from "@/sections/subhero/index.astro";
import { DEFAULT_LOCALE, getHomePage } from "../lib/sanity";

const pageData = await getHomePage(DEFAULT_LOCALE, DEFAULT_LOCALE);
const email = pageData?.email || "g.ratajczak97@gmail.com";
const phone = pageData?.phone || "795 451 486";
---

<Layout
    title="Contact"
    headerMenuItems={pageData?.headerMenuItems ?? []}
    footerMenuItems={pageData?.footerMenuItems ?? []}
    phone={phone}
    email={email}
    instagram={pageData?.instagram ?? ""}
    linkedin={pageData?.linkedin ?? ""}
    github={pageData?.github ?? ""}
>
    <main>
        <Subhero eyebrow="Get in touch" heading="Contact" highlightLine />
        <ContactForm
            email={email}
            phone={phone}
            linkedin={pageData?.linkedin ?? ""}
            github={pageData?.github ?? ""}
            instagram={pageData?.instagram ?? ""}
            locale="en"
        />
    </main>
</Layout>
