{
    "name": "portfolio",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "compatibility_date": "2026-04-22",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
    },
    // Cloudflare checks its cache before invoking the Worker. Pages opt in
    // with `s-maxage` (src/middleware.ts); /api/revalidate purges it.
    "cache": {
        "enabled": true,
    },
}
